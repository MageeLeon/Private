# DOMAIN 域名精确等于
#UK-wifi-call VOXI
DOMAIN,vfgb.idemia.io

# DOMAIN-KEYWORD 域名包含关键字
#英国monzo
DOMAIN-KEYWORD,monzo
#UK-wifi-call/地区检测
DOMAIN-KEYWORD,mcc234

# DOMAIN-WILDCARD 通配符匹配
#DOMAIN-WILDCARD,login-*.psu.edu

# DOMAIN-REGEX 正则表达式匹配

